{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/crlf.js\"",
            "timeout": 10,
            "statusMessage": "Converting to CRLF"
          }
        ]
      }
    ]
  }
}
